{
  "name": "oscurapdf",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run licenses && tsc -p tsconfig.json --noEmit && vite build && npm run deploy:check -- dist",
    "build:e2e-fault": "npm run licenses && vite build --mode e2e-fault --outDir dist-e2e-fault",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:e2e-fault": "vite preview --mode e2e-fault --outDir dist-e2e-fault --port 4174 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:guard": "tsx tools/coverage-guard/compare.ts",
    "test:e2e": "playwright test --grep-invert @perf",
    "eval:ner": "tsx tools/ner-eval/run.ts",
    "models:fetch": "tsx tools/fetch-models/fetch.ts && tsx tools/runtime-assets/copy.ts",
    "fixtures:build": "tsx tools/fixtures/build.ts",
    "arch:local": "npx -y -p node@22 node node_modules/dependency-cruiser/bin/dependency-cruiser.mjs src --config .dependency-cruiser.cjs",
    "test:perf": "playwright test --grep @perf --workers=1",
    "licenses": "tsx tools/licenses/generate.ts",
    "deploy:check": "tsx tools/deploy-check/check.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "i18next": "26.4.2",
    "mupdf": "1.28.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "pdf-lib": "1.17.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
